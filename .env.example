NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://bybit_app:URL_ENCODED_APP_PASSWORD@localhost:5432/bybit_p2p
DATABASE_URL_DOCKER=postgresql://bybit_app:URL_ENCODED_APP_PASSWORD@postgres:5432/bybit_p2p
BYBIT_APP_DB_PASSWORD=replace-with-the-bybit_app-password
POSTGRES_ADMIN_PASSWORD=replace-with-a-docker-postgres-admin-password
# URL-encode special characters in the password portion of both connection URLs.

JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_COOKIE_SECURE=false

# Redis for distributed caching, rate-limiting, and job coordination.
# Defaults to the Docker Compose service hostname. Set to empty to operate
# without Redis (single-instance in-memory mode only).
REDIS_URL=redis://redis:6379
# How long market data stays in the Redis cache (seconds). Default: 5.
# Keep this short relative to the scan interval to avoid stale prices.
REDIS_MARKET_DATA_TTL_SEC=5

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=
BYBIT_TESTNET=false

P2P_AUTO_SCAN=true
P2P_SCAN_INTERVAL_MS=5000
P2P_LARGE_CHANGE_THRESHOLD_NGN=600
P2P_MINIMUM_UPDATE_INTERVAL_MS=60000
P2P_MAX_UPDATES_PER_AD_PER_MINUTE=1
P2P_MAX_UPDATES_PER_DAY=100
P2P_MAX_MARKET_DATA_AGE_MS=15000
P2P_REFERENCE_MAX_AGE_DAYS=30
# Live mode remains disabled until explicit minimum and maximum prices are configured.
P2P_LIVE_MIN_PRICE_NGN=
P2P_LIVE_MAX_PRICE_NGN=
P2P_LIVE_MAX_CHANGE_NGN=600
